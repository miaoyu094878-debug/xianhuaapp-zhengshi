GEMINI_API_KEY=
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
SUPABASE_ANON_KEY=
SUPABASE_URL=
# ── Dodo Payments（订阅收款）──
# 注意：这些只在服务端使用，配到 Supabase Edge Function 的 secrets 里，不要放进前端
# 变量名以 Supabase secrets 实际存储的 DODO_ALYEMA_* 为准；下面的旧名保留为兜底
DODO_ALYEMA_API_KEY=
DODO_ALYEMA_WEBHOOK_SECRET=
# 四个订阅产品（档位 × 周期），Brand 都选 Alyema
# Pro：$9.90 / 月、$70.00 / 年（随附积分 990 / 10500）
DODO_ALYEMA_PRO_MONTHLY_PRODUCT_ID=
DODO_ALYEMA_PRO_YEARLY_PRODUCT_ID=
# Lite：$5.00 / 月、$29.00 / 年（不含 AI，不发积分）
DODO_ALYEMA_LITE_MONTHLY_PRODUCT_ID=
DODO_ALYEMA_LITE_YEARLY_PRODUCT_ID=
# ── 旧变量名（无 ALYEMA 前缀），代码会兜底读取，新环境直接用上面的新名 ──
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_YEARLY=
DODO_PRODUCT_ID_LITE_MONTHLY=
DODO_PRODUCT_ID_LITE_YEARLY=
# 测试模式改填 https://test.dodopayments.com
DODO_API_BASE=https://live.dodopayments.com
DODO_RETURN_URL=https://www.alyema.com/index.html